APP_BASE_URL=https://autopark.example.ru
HOST=127.0.0.1
PORT=3000
AUTH_MODE=bitrix
SEED_DEMO_DATA=false
DATABASE_URL=postgres://autopark:replace-with-url-encoded-password@127.0.0.1:5432/autopark
DATABASE_SSL=disable
FILE_STORAGE_DIR=/var/lib/autopark/files
FILE_MAX_BYTES=10485760

BITRIX_CLIENT_ID=local.xxxxx
BITRIX_CLIENT_SECRET=replace-with-bitrix-secret
BITRIX_ALLOWED_DOMAINS=company.bitrix24.ru
BITRIX_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
BITRIX_VEHICLE_ENTITY_TYPE_ID=1302
BITRIX_VEHICLE_FIELD_MAP={"plateNumber":"ufCrm10_100","model":"ufCrm10_101","status":"ufCrm10_102","currentDriverBitrixUserId":"ufCrm10_103"}
