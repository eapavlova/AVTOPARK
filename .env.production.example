APP_BASE_URL=https://autopark.example.ru
POSTGRES_DB=autopark
POSTGRES_USER=autopark
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://autopark:replace-with-url-encoded-password@postgres:5432/autopark
FILE_MAX_BYTES=10485760

BITRIX_CLIENT_ID=local.xxxxx
BITRIX_CLIENT_SECRET=replace-with-bitrix-secret
