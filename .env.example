PORT=3000
APP_BASE_URL=http://127.0.0.1:3000
AUTH_MODE=local
BITRIX_VEHICLE_ENTITY_TYPE_ID=
BITRIX_VEHICLE_FIELD_MAP={}
SEED_DEMO_DATA=false
FILE_STORAGE_DIR=./data/files
FILE_MAX_BYTES=10485760

# Bitrix24 settings
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=
BITRIX_ALLOWED_DOMAINS=your-company.bitrix24.ru
BITRIX_TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
BITRIX_BIND_LEFT_MENU=true

DATABASE_URL=postgres://autopark:autopark@localhost:5432/autopark
# Для подключений к внешней БД: disable, require или verify-full.
DATABASE_SSL=disable
