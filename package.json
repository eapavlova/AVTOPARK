{
  "name": "autopark-bitrix24-local-app",
  "version": "0.1.0",
  "private": true,
  "description": "Local server app for Autopark workflows integrated with Bitrix24.",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate-cli.js",
    "db:import-json": "node --env-file-if-exists=.env src/db/import-json-cli.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "pg": "^8.23.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
